# ========================
# Mini D-Mart Environment Variables
# ========================
# Copy this file to .env (or backend/.env and frontend/.env)
# NEVER commit the .env file to version control containing real secrets.

# ========================
# Backend (Spring Boot)
# ========================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=minidmart
DB_USER=root
DB_PASSWORD=
DB_SSL_MODE=DISABLED

# JWT Security
JWT_SECRET=your-256-bit-secret-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=604800000

# CORS Configuration
CORS_ORIGINS=http://localhost:5173

# Stripe Integrations
STRIPE_SECRET_KEY=

# ========================
# Frontend (React / Vite)
# ========================
VITE_API_URL=http://localhost:8080/api
VITE_STRIPE_PUBLISHABLE_KEY=
